# Docker ignore for monorepo root
# When building from root context

# Dependencies
**/node_modules/
**/.pnp
**/.pnp.js

# Testing
**/coverage/
**/.nyc_output/
**/*.test.ts
**/*.spec.ts
**/test/
# apps/site runs its suite INSIDE the image (a broken page cannot deploy) —
# its tests must survive the context. LAST MATCH WINS: these negations must
# sit AFTER **/test/ or that later rule silently re-excludes the directory
# (it did — build 80bc8011 failed on exactly this).
!apps/site/test/
!apps/site/test/**

# Environment files
**/.env
**/.env.local
**/.env.*.local
**/*.log

# Build artifacts
**/dist/
**/build/
**/*.tsbuildinfo

# IDE
.vscode/
.idea/
**/*.swp
**/*.swo
**/*~

# Git
.git/
.gitignore
.gitattributes

# Documentation
README.md
*.md
docs/
plans/

# CI/CD
.github/
.gitlab-ci.yml

# Docker
**/Dockerfile*
**/docker-compose*.yml
**/.dockerignore

# Mobile app (not needed for API build)
apps/mobile/
ios/
android/

# Development files
**/.prettierrc
**/.prettierignore
**/.eslintrc*
**/.editorconfig
lefthook.yml
Makefile

# Observability config (for local dev only)
observability/

# OS files
.DS_Store
Thumbs.db
