      "foods": {
        "include": [["spicy tuna roll"], ["tuna roll"]],
        "exclude": ["tuna"]
      },
      "foodAttributes": { "include": [["spicy"]] },
      "ingredients": { "empty": true }
    }
  },
  {
    "id": "chain-pho-tai",
